# Team salt from the slip. Never commit the real value.
DAY1_SALT=replace-with-your-team-salt
# Optional: explicit JWT signing secret (defaults to a key derived from DAY1_SALT)
JWT_SECRET=
# Set automatically by docker-compose for the api service
DATABASE_URL=postgresql://nascon:nascon@db:5432/nascon
REDIS_URL=redis://redis:6379/0
